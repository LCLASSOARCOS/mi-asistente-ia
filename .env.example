# Copia este archivo como .env y agrega tus claves solo en el archivo local.
# Nunca subas una clave real a GitHub.

# --- Proveedores de IA ---
# Al menos uno debe estar configurado.
GEMINI_API_KEY=tu_clave_aqui
ANTHROPIC_API_KEY=tu_clave_aqui
# Todavia opcional: el proveedor OpenAI no esta implementado.
OPENAI_API_KEY=

# --- Servidor ---
# Puerto del backend.
PORT=3000
# Direccion desde la que se abre la interfaz (origen permitido por CORS).
CLIENT_ORIGIN=http://localhost:5173

# --- Fiabilidad ---
# Si un proveedor falla, intentar con el siguiente. "false" lo apaga.
ASISTENTE_FALLBACK=true
# Cuanto esperar a un proveedor antes de darlo por perdido.
ASISTENTE_TIEMPO_LIMITE_MS=60000
# Reintentos con el MISMO proveedor ante fallos transitorios (503).
ASISTENTE_REINTENTOS=1

# --- Documentos ---
# Maximo de texto documental que acompana a una pregunta.
# Decide si se mandan los documentos enteros o solo fragmentos.
ASISTENTE_PRESUPUESTO_DOCUMENTAL=80000

# --- Contexto del sistema ---
# Zona horaria que el asistente usa para fecha y hora.
ASISTENTE_ZONA_HORARIA=America/Bogota
